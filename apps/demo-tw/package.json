{
  "name": "@publira/comic-viewer-tailwind-demo",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#components/*": {
      "types": [
        "./app/_components/*.ts",
        "./app/_components/*.tsx"
      ],
      "default": "./app/_components/*"
    }
  },
  "scripts": {
    "dev": "next dev --port 4000",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@publira/comic-viewer": "workspace:*",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
