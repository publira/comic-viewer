    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@publira/comic-viewer": "workspace:*",
    "@sugar-high/react": "2.5.1",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sugar-high": "2.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
