{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["@publira/comic-viewer-demo#build"],
      "outputs": []
    },
    "typegen": {
      "outputs": [".next/types/**"]
    },
    "typecheck": {
      "dependsOn": ["typegen", "^typecheck"],
      "outputs": []
    }
  }
}
