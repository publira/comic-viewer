{
  "name": "Publira Comic Viewer",
  "image": "ghcr.io/publira/base-images/publira-dev:2026.10.04@sha256:3aeffdcfe550a53ad9c57c0c86e7ded25a4c504434fa9218f06924fb766fe12a",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {}
  },
  "mounts": [
    "source=comic-viewer-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=comic-viewer-codex-${devcontainerId},target=/home/vscode/.codex,type=volume",
    "source=comic-viewer-gemini-${devcontainerId},target=/home/vscode/.gemini,type=volume",
    "source=comic-viewer-gh-${devcontainerId},target=/home/vscode/.config/gh,type=volume",
    "source=comic-viewer-grok-${devcontainerId},target=/home/vscode/.grok,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode"]
    }
  },
  "postCreateCommand": ".devcontainer/post-create.sh"
}
