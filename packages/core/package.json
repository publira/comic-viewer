{
  "name": "@publira/comic-viewer",
  "version": "0.8.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/publira/comic-viewer.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "src/default.css"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./default.css": "./src/default.css",
    "./core.css": "./src/default.css"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "tsdown": "0.23.0",
    "vitest": "5.0.0"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
